# ==========================================================================
# DevOps Incident Agent — environment configuration
# Copy this file to `.env` and fill in the values you have.
# Everything is OPTIONAL: with no config the agent runs fully in MOCK MODE
# using synthetic evidence, so you can try it end-to-end without any infra.
# ==========================================================================

# ---- App ----
APP_NAME="DevOps Incident Agent"
APP_ENV=development           # development | production
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# ---- LLM provider ----
# provider: gemini | openai | anthropic | mock
# Leave as `mock` (or omit keys) to run without any LLM API key.
LLM_PROVIDER=gemini
LLM_MODEL=                    # optional override, e.g. gemini-1.5-flash

# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---- Global mock switch ----
# When true, ALL collectors return synthetic data and the LLM uses the
# offline rule-based engine even if keys are present. Great for demos/CI.
MOCK_MODE=true

# ---- Prometheus ----
PROMETHEUS_URL=               # e.g. http://localhost:9090

# ---- Alertmanager ----
ALERTMANAGER_URL=             # e.g. http://localhost:9093

# ---- Loki ----
LOKI_URL=                     # e.g. http://localhost:3100

# ---- Kubernetes ----
# If empty, the in-cluster / default kubeconfig is used when MOCK_MODE=false.
KUBECONFIG=
K8S_NAMESPACE=default

# ---- GitHub ----
GITHUB_TOKEN=
GITHUB_REPO=                  # e.g. owner/repo

# ---- Jenkins ----
JENKINS_URL=                  # e.g. https://jenkins.example.com
JENKINS_USER=
JENKINS_TOKEN=

# ---- Storage (optional) ----
DATABASE_URL=                 # e.g. postgresql+psycopg2://user:pass@localhost:5432/incidents
REDIS_URL=                    # e.g. redis://localhost:6379/0
